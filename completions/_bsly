_bsly_commands() {
    local commands; commands=(
'list:List connected Bugslayer decks and their USB devices' \
'select:Pick which deck to use by default when several are connected' \
'info:Firmware versions, serial number and USB devices of the deck' \
'status:Capture engine and FX2 link status' \
'pins:Live level of every expansion-port signal' \
'power:Switch the deck'\''s high-side power switches (prompts when omitted)' \
'pull:I2C pull-ups on the expansion port (standalone only; prompts when omitted)' \
'fx2:Control the FX2 (CBM9002A) capture pipe (prompts when omitted)' \
'capture:Record the expansion port\: arm, stream, verify and write a sigrok .sr' \
'decode:Decode a saved capture' \
'i2c:Raw I2C on the expansion port, with the deck as master' \
'deckctrl:Deck controllers (DeckCtrl) on the expansion-port I2C bus' \
'uart:Print what UART lines on the expansion port carry (sniffed, never driven)' \
'mux:Switch the port'\''s TX2/RX2 between UART2 and USB (the deck'\''s hub port 4, for decks with a USB MCU there\: D- = TX2, D+ = RX2); standalone only' \
'drive:Hold an IO pin low, e.g. a deck MCU'\''s BOOT line, or release it (open drain, never driven high; standalone only)' \
'bridge:Bridge the Crazyflie'\''s UART1/UART2 to a serial port of the deck, with the deck standing in for the Crazyflie (standalone only)' \
'update:Check the deck'\''s firmware against the GitHub releases and install updates through the USB bootloaders (private repos\: \`gh auth login\`)' \
'swo:Print a target'\''s SWO trace (ITM, e.g. the Crazyflie'\''s DEBUG_PRINT)' \
'raw:Send raw control-channel lines; with none, open an interactive console' \
'settings:Local CLI settings' \
'completions:Generate a shell completion script (printed to stdout)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'bsly commands' commands "$@"
